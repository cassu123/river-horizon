# ============================================================
# River Horizon — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# River Song API
RIVER_SONG_API_URL=https://api.riversongai.com
RIVER_SONG_API_KEY=your-api-key-here

# Drone profile path (optional — defaults to units/drone_profile.json)
# DRONE_PROFILE=/path/to/units/drone_profile.json

# Web controller port (optional — defaults to 8080)
# WEB_CONTROLLER_PORT=8080

# Log level (optional — defaults to INFO on console, DEBUG in file)
# LOG_LEVEL=INFO
